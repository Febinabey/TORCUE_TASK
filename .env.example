# Server Configuration
PORT=3001
NODE_ENV=development

# Dataset Path (relative to project root or absolute)
DATA_FILE_PATH=data/orders.csv

# Gemini API Configuration
# Obtain a key from https://aistudio.google.com/
# Keep the real key in .env locally or in your hosting provider's secret settings.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
